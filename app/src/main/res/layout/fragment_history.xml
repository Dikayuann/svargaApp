<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".HistoryFragment"
    android:background="@color/cream">

    <!-- Header Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/rectangle1"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Title TextView -->
        <TextView
            android:id="@+id/textViewRiwayat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_semibold"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:text="Riwayat"
            android:textColor="@color/white"
            android:textSize="22sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Horizontal ScrollView with Buttons Below Header -->
    <HorizontalScrollView
        android:id="@+id/horizontal_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"

        android:scrollbars="none"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        android:layout_marginHorizontal="25dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Button Show all -->
            <TextView
                android:id="@+id/btnAll"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/button_category_active"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="All"
                android:textAlignment="center"
                android:textColor="@color/cream"
                android:textSize="12sp" />

            <!-- Button Hot -->
            <TextView
                android:id="@+id/btnRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/button_category_inactive"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Riwayat"
                android:textAlignment="center"
                android:textColor="@color/green"
                android:textSize="12sp" />

            <!-- Button Cold -->
            <TextView
                android:id="@+id/btnProses"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/button_category_inactive"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Dalam Proses"
                android:textAlignment="center"
                android:textColor="@color/green"
                android:textSize="12sp" />

            <!-- Button Others -->
            <TextView
                android:id="@+id/btnDraf"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/button_category_inactive"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Draf"
                android:textAlignment="center"
                android:textColor="@color/green"
                android:textSize="12sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="23dp"
        android:layout_marginTop="10dp"
        android:paddingBottom="100dp"
        app:layout_constraintTop_toBottomOf="@id/horizontal_scroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_menu" />





</androidx.constraintlayout.widget.ConstraintLayout>
