<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/cream"
    tools:context=".ProfileFragment">

    <!-- Header yang tidak bisa di-scroll -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="20dp"
        android:background="@drawable/rectangle1"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textHeaderProfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Profil"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@id/headerProfile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Konten yang dapat digulir (scroll) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="20dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerProfile">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/widgetProfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/rectangle3"
                android:paddingBottom="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/content">

                <TextView
                    android:id="@+id/textProfilCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Profil"
                    android:textColor="@color/green"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/imageViewFrameProfile"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardCornerRadius="70dp"
                    app:cardElevation="4dp"
                    android:layout_marginStart="15dp"
                    app:layout_constraintTop_toTopOf="@id/textProfileName"
                    app:layout_constraintBottom_toBottomOf="@id/textProfileEmail"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:id="@+id/imageViewProfile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="image"
                        android:src="@drawable/janu_profile"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/textProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Janu Putra Atmajaya"
                    android:textColor="@color/green"
                    android:textSize="15sp"
                    app:layout_constraintStart_toEndOf="@id/imageViewFrameProfile"
                    app:layout_constraintTop_toBottomOf="@id/textProfilCard" />

                <TextView
                    android:id="@+id/textProfileEmail"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/montserrat_light"
                    android:text="januputra@gmail.com"
                    android:textColor="@color/green"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/imageViewFrameProfile"
                    app:layout_constraintTop_toBottomOf="@id/textProfileName" />


            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/widgetSetting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingVertical="10dp"
                android:background="@drawable/rectangle3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/widgetProfil">

                <TextView
                    android:id="@+id/textSettingAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Pengaturan Akun"
                    android:textColor="@color/green"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/profile"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:background="@drawable/profile"
                    android:layout_marginStart="15dp"
                    app:layout_constraintTop_toTopOf="@id/textPrivateInfo"
                    app:layout_constraintBottom_toBottomOf="@id/textPrivateInfo"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textPrivateInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Informasi Pribadi"
                    android:drawablePadding="10dp"
                    android:textColor="@color/green"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/profile"
                    app:layout_constraintTop_toBottomOf="@id/textSettingAccount" />

                <ImageView
                    android:id="@+id/setting"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:background="@drawable/settings"
                    android:layout_marginStart="15dp"
                    app:layout_constraintTop_toTopOf="@id/textSetting"
                    app:layout_constraintBottom_toBottomOf="@id/textSetting"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textSetting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Pengaturan"
                    android:drawablePadding="10dp"
                    android:textColor="@color/green"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/setting"
                    app:layout_constraintTop_toBottomOf="@id/textPrivateInfo" />

                <ImageView
                    android:id="@+id/notification"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:background="@drawable/bell"
                    android:layout_marginStart="15dp"
                    app:layout_constraintTop_toTopOf="@id/textNotificaton"
                    app:layout_constraintBottom_toBottomOf="@id/textNotificaton"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textNotificaton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Informasi Pribadi"
                    android:drawablePadding="10dp"
                    android:textColor="@color/green"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/notification"
                    app:layout_constraintTop_toBottomOf="@id/textSetting" />

                <ImageView
                    android:id="@+id/editProfile"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:background="@drawable/edit"
                    android:layout_marginStart="15dp"
                    app:layout_constraintTop_toTopOf="@id/textEditProfile"
                    app:layout_constraintBottom_toBottomOf="@id/textEditProfile"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textEditProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Edit Profile"
                    android:drawablePadding="10dp"
                    android:textColor="@color/green"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/editProfile"
                    app:layout_constraintTop_toBottomOf="@id/textNotificaton" />

                <ImageView
                    android:id="@+id/privacy"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:background="@drawable/privacy"
                    android:layout_marginStart="15dp"
                    app:layout_constraintTop_toTopOf="@id/textPrivacy"
                    app:layout_constraintBottom_toBottomOf="@id/textPrivacy"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textPrivacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Privacy &amp; Keamanan"
                    android:drawablePadding="10dp"
                    android:textColor="@color/green"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/privacy"
                    app:layout_constraintTop_toBottomOf="@id/textEditProfile" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/widgetOthers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="180dp"
                android:paddingVertical="10dp"
                android:background="@drawable/rectangle3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/widgetSetting"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/textOthers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Lainnya"
                    android:textColor="@color/green"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/Faq"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:background="@drawable/question"
                    android:layout_marginStart="15dp"
                    app:layout_constraintTop_toTopOf="@id/textFaq"
                    app:layout_constraintBottom_toBottomOf="@id/textFaq"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textFaq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="FAQ"
                    android:drawablePadding="10dp"
                    android:textColor="@color/green"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/Faq"
                    app:layout_constraintTop_toBottomOf="@id/textOthers" />

                <ImageView
                    android:id="@+id/helpCenter"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:background="@drawable/service"
                    android:layout_marginStart="15dp"
                    app:layout_constraintTop_toTopOf="@id/textHelpCenter"
                    app:layout_constraintBottom_toBottomOf="@id/textHelpCenter"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textHelpCenter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Pusat Bantuan"
                    android:drawablePadding="10dp"
                    android:textColor="@color/green"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/helpCenter"
                    app:layout_constraintTop_toBottomOf="@id/textFaq" />

                <ImageView
                    android:id="@+id/language"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/language"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="@id/textLanguage"
                    app:layout_constraintBottom_toBottomOf="@id/textLanguage"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Bahasa"
                    android:drawablePadding="10dp"
                    android:textColor="@color/green"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/language"
                    app:layout_constraintTop_toBottomOf="@id/textHelpCenter" />

                <ImageView
                    android:id="@+id/report"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/report"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="@id/textReport"
                    app:layout_constraintBottom_toBottomOf="@id/textReport"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textReport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Laporkan Bug"
                    android:drawablePadding="10dp"
                    android:textColor="@color/green"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/report"
                    app:layout_constraintTop_toBottomOf="@id/textLanguage" />

                <ImageView
                    android:id="@+id/rating"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/star"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="@id/textRating"
                    app:layout_constraintBottom_toBottomOf="@id/textRating"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Berikan Penilaian"
                    android:drawablePadding="10dp"
                    android:textColor="@color/green"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/rating"
                    app:layout_constraintTop_toBottomOf="@id/textReport" />

                <ImageView
                    android:id="@+id/quit"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/logout"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="@id/textQuit"
                    app:layout_constraintBottom_toBottomOf="@id/textQuit"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textQuit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Keluar"
                    android:drawablePadding="10dp"
                    android:textColor="@color/green"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/quit"
                    app:layout_constraintTop_toBottomOf="@id/textRating" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Creative Minds"
                android:textAlignment="center"
                android:textSize="15sp"
                android:textColor="@color/green"
                android:fontFamily="@font/montserrat_semibold"
                app:layout_constraintTop_toBottomOf="@id/widgetOthers"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="81dp" />

</androidx.constraintlayout.widget.ConstraintLayout>