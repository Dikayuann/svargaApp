<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/widgetPayment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        android:background="@drawable/rectangle3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ImageView
            android:id="@+id/discountLogo"
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:layout_marginStart="15dp"
            app:layout_constraintBottom_toBottomOf="@id/textDiscountDesc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/widgetPayment" />

        <TextView
            android:id="@+id/textNameDiscount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Discount"
            android:textColor="@color/green"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@id/discountLogo"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textDiscountDesc"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Berlaku s/d --"
            android:textColor="@color/green"
            android:textSize="11sp"
            app:layout_constraintStart_toEndOf="@id/discountLogo"
            app:layout_constraintTop_toBottomOf="@id/textNameDiscount" />

        <TextView
            android:id="@+id/textButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="15dp"
            android:background="@drawable/rectangle4"
            android:fontFamily="@font/montserrat_semibold"
            android:paddingHorizontal="22dp"
            android:paddingVertical="7dp"
            android:text="Pilih"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:focusable="true"
            android:clickable="true"
            android:importantForAccessibility="yes"
            app:layout_constraintBottom_toBottomOf="@id/textDiscountDesc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/textNameDiscount" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>